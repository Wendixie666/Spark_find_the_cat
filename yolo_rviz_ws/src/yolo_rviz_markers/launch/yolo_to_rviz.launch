<launch>
  <arg name="rgb_topic" default="/camera/rgb/image_raw"/>
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/camera/rgb/camera_info"/>
  <arg name="odom_topic" default="/rtabmap/odom"/>
  <arg name="target_frame" default="map"/>
  <arg name="detected_topic" default="/detected_objects"/>
  <arg name="marker_topic" default="/visualization_marker"/>
  <arg name="target_class" default="bottle"/>
  <arg name="yolo_model" default="yolov8n.pt"/>
  <node name="yolo_to_rviz" pkg="yolo_rviz_markers" type="yolo_to_rviz.py" output="screen">
    <param name="rgb_topic" value="$(arg rgb_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="detected_topic" value="$(arg detected_topic)"/>
    <param name="marker_topic" value="$(arg marker_topic)"/>
    <param name="target_class" value="$(arg target_class)"/>
    <param name="yolo_model" value="$(arg yolo_model)"/>
  </node>
</launch>
