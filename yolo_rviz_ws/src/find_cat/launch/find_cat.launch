<launch>
  <!--
    Example launch for the terminal decision node.
    Tune lab_* and total_cells to match your fixed experimental area.
  -->
  <node pkg="find_cat" type="hajimi.py" name="find_cat_hajimi" output="screen">
    <!-- Fixed ROI in map frame for coverage denominator and numerator -->
    <param name="lab_offset_x" value="0.15" />
    <param name="lab_offset_y" value="0.15" />
    <param name="lab_width_m" value="3.60" />
    <param name="lab_height_m" value="5.80" />
    <param name="lab_resolution_m" value="0.05" />
    <param name="total_cells" value="19200" />

    <!-- Decision thresholds -->
    <param name="coverage_threshold" value="0.95" />
    <param name="arrival_distance_m" value="0.5" />
    <param name="max_wait_cat_after_coverage_sec" value="30.0" />

    <!-- Cat detection lock policy -->
    <param name="cat_class_name" value="cat" />
    <param name="required_cat_hits" value="1" />
    <param name="cat_hit_max_distance_m" value="0.30" />

    <!-- Depth validity -->
    <param name="depth_min_m" value="0.2" />
    <param name="depth_max_m" value="6.0" />

    <!-- Frames and process control -->
    <param name="base_frame" value="base_link" />
    <param name="explore_node_name" value="/explore" />

    <!-- Topics -->
    <param name="map_topic" value="/map" />
    <param name="depth_topic" value="/camera/depth/image_rect_raw" />
    <param name="camera_info_topic" value="/camera/depth/camera_info" />
    <param name="yolo_topic" value="/yolo/bounding_boxes" />
  </node>
</launch>
