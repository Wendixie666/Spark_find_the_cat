<launch>
  <arg name="model_path" default="yolov8n.pt" />
  <arg name="rgb_topic" default="/camera/rgb/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_rect_raw" />
  <arg name="camera_info_topic" default="/camera/depth/camera_info" />

  <node pkg="find_cat" type="find_cat_node.py" name="find_cat" output="screen">
    <param name="model_path" value="$(arg model_path)" />
    <param name="inference_confidence" value="0.5" />
    <param name="target_class" value="cat" />

    <param name="rgb_topic" value="$(arg rgb_topic)" />
    <param name="depth_topic" value="$(arg depth_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="map_topic" value="/map" />
    <param name="target_frame" value="map" />
    <param name="base_frame" value="base_link" />

    <param name="coverage_threshold" value="0.95" />
    <param name="lab_width_m" value="5.1" />
    <param name="lab_height_m" value="3.6" />

    <param name="confirmation_hits" value="3" />
    <param name="cluster_distance_m" value="0.5" />
    <param name="depth_min_m" value="0.3" />
    <param name="depth_max_m" value="4.0" />
    <param name="arrival_distance_m" value="0.5" />
    <param name="target_offset_m" value="0.5" />
    <param name="explore_node_name" value="/explore" />
  </node>
</launch>
